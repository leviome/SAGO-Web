{
    "name": "sago-web",
    "version": "1.0.0",
    "author": "PlayCanvas<support@playcanvas.com>",
    "homepage": "https://github.com/leviome/SAGO-Web",
    "description": "Web tool for SAGO (ECCV 2026): browser-only 3D Gaussian segmentation with SAM2 Large and Virtual Drone",
    "keywords": [
        "playcanvas",
        "ply",
        "gaussian",
        "splat",
        "editor",
        "sago",
        "eccv-2026",
        "webgpu",
        "segmentation"
    ],
    "license": "MIT",
    "main": "index.js",
    "scripts": {
        "build": "rollup -c",
        "watch": "rollup -c -w",
        "serve": "serve dist -C",
        "develop": "cross-env BUILD_TYPE=debug concurrently --kill-others \"npm run watch\" \"npm run serve\"",
        "develop:auto-launch": "concurrently --kill-others \"xdg-open 'http://localhost:3000/'\" \"npm run watch\" \"npm run serve\"",
        "lint": "eslint src",
        "lint:locales": "node scripts/check-locales.mjs",
        "models:download": "node scripts/download-models.mjs",
        "typecheck": "tsc --noEmit",
        "test:sago": "node --experimental-strip-types --test --test-isolation=none tests/mask-utils.test.mjs tests/sam2-utils.test.mjs tests/model-assets.test.mjs tests/drone-utils.test.mjs",
        "test:browser": "playwright test",
        "models:export": "node scripts/download-models.mjs"
    },
    "engines": {
        "node": ">=20.19.0"
    },
    "devDependencies": {
        "@playcanvas/eslint-config": "2.1.0",
        "@playcanvas/pcui": "6.1.4",
        "@playcanvas/splat-transform": "3.5.0",
        "@playwright/test": "^1.63.0",
        "@rollup/plugin-alias": "6.0.0",
        "@rollup/plugin-image": "3.0.3",
        "@rollup/plugin-json": "6.1.0",
        "@rollup/plugin-node-resolve": "16.0.3",
        "@rollup/plugin-terser": "1.0.0",
        "@rollup/plugin-typescript": "12.3.0",
        "@types/wicg-file-system-access": "2023.10.7",
        "@typescript-eslint/eslint-plugin": "8.70.0",
        "@typescript-eslint/parser": "8.70.0",
        "@webgpu/types": "0.1.74",
        "autoprefixer": "10.6.1",
        "concurrently": "10.0.5",
        "cross-env": "10.1.0",
        "eslint": "^9.39.5",
        "eslint-import-resolver-typescript": "4.4.5",
        "globals": "17.12.0",
        "i18next": "26.4.2",
        "i18next-browser-languagedetector": "8.2.1",
        "i18next-http-backend": "4.0.2",
        "mediabunny": "1.58.1",
        "playcanvas": "2.22.3",
        "postcss": "8.5.28",
        "rollup": "4.63.4",
        "rollup-plugin-scss": "4.0.1",
        "sass": "1.104.1",
        "serve": "14.2.6",
        "tslib": "2.8.1",
        "typescript": "6.0.3"
    },
    "dependencies": {
        "@huggingface/transformers": "3.8.1",
        "onnxruntime-common": "1.23.2",
        "onnxruntime-web": "1.23.2"
    },
    "private": true,
    "contributors": [
        "leviome"
    ],
    "upstream": {
        "name": "SuperSplat",
        "version": "3.3.1",
        "repository": "https://github.com/playcanvas/supersplat",
        "commit": "c9e29913f3c86f2a4ae80f71b331116ac7eb6815"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/leviome/SAGO-Web.git"
    }
}
